# ============================================================
# Malik Shahzad Portfolio API — environment variables
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored; never commit it.
# ============================================================

# --- PostgreSQL (Neon) --------------------------------------
# Get this from Neon: Dashboard → Connection Details → "psql" or
# "Connection string". Your DB must have the pgvector extension enabled
# (Neon: Database → Extensions → check `vector`).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Gemini (RAG embeddings) ---------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Qdrant (vector database) --------------------------------
# https://cloud.qdrant.io → cluster → Access. Endpoint is the cluster URL
# (e.g. https://xxxx.region.aws.cloud.qdrant.io), key is the API key.
QDRANT_API_KEY=replace-me
QDRANT_CLUSTER_ENDPOINT=replace-me
# QDRANT_COLLECTION=portfolio_knowledge

# --- OpenRouter (LLM provider for chat) ----------------------
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT ----------------------------------------------
# Long random string used to sign session JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=replace-me-with-a-long-random-string
# TOKEN_EXPIRE_MINUTES=10080

# --- Optional overrides --------------------------------------
# ANTHROPIC_MODEL=claude-opus-5
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=4
# CHAT_MAX_TOKENS=1024
